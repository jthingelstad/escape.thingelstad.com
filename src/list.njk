---
title: All Rooms
description: Browse and filter all escape rooms.
permalink: /list/
---
{% extends "base.njk" %}

{% block content %}
  <main class="container page-content catalog-page" data-pagefind-ignore>
    <section class="page-intro">
      <div class="eyebrow">Room Catalog</div>
      <div class="page-intro-copy">
        <h1 class="page-intro-title">All Rooms</h1>
        <p>A single-search way to browse the full room catalog. Search room names, companies, places, players, awards, trips, lists, themes, years, and status from one field.</p>
      </div>
    </section>

    <section class="filter-bar">
      {% set compactFilters = true %}
      <div class="filter-row">
        {% include "filter-bar.njk" %}
      </div>
      <div class="active-filters" id="active-filters"></div>
    </section>

    <section>
      <div class="catalog-toolbar">
        <div class="section-header">
          <h2>Catalog Results</h2>
          <p>Sort the catalog by date, game, company, or city while keeping search shareable in the URL.</p>
        </div>

        <div class="sort-controls">
          <span>Sort by:</span>
          <button class="sort-btn active" data-sort="date" data-dir="desc" data-tinylytics-event="list.sort" data-tinylytics-event-value="date">Date &#9660;</button>
          <button class="sort-btn" data-sort="game" data-tinylytics-event="list.sort" data-tinylytics-event-value="game">Game</button>
          <button class="sort-btn" data-sort="company" data-tinylytics-event="list.sort" data-tinylytics-event-value="company">Company</button>
          <button class="sort-btn" data-sort="city" data-tinylytics-event="list.sort" data-tinylytics-event-value="city">City</button>
        </div>
      </div>

      <div class="results-count" id="results-count"></div>
      <div class="room-grid" id="room-list">
        {% from "room-card.njk" import roomCard %}
        {% for room in catalog.rooms | reverse %}
          {{ roomCard(room) }}
        {% endfor %}
      </div>
    </section>
  </main>
{% endblock %}

{% block scripts %}
  <script>
    (function() {
      var hash = window.location.hash.slice(1);
      if (hash && hash.startsWith('rec')) {
        var card = document.getElementById(hash);
        if (card) {
          var link = card.querySelector('.room-card-link');
          if (link) { window.location.replace(link.href); return; }
        }
      }
    })();
  </script>
  <script id="room-index-data" type="application/json">{{ roomIndex | dump | safe }}</script>
  <script type="module" src="{{ '/js/list.js' | cacheBust }}"></script>
{% endblock %}
