---
title: All Rooms
description: Browse and filter all escape rooms.
permalink: /rooms/
---
{% extends "base.njk" %}

{% block content %}
  <main class="container page-content catalog-page" data-pagefind-ignore>
    <section class="page-intro">
      <div class="page-intro-copy">
        <h1 class="page-intro-title">All Rooms</h1>
        <p>Browse the full room catalog using the filters below. Press <kbd>/</kbd> or <kbd>⌘K</kbd> for text search.</p>
      </div>
    </section>

    <section class="filter-bar collapsed" id="filter-panel">
      <button class="filter-bar-toggle" id="filter-toggle" type="button">
        <span class="toggle-arrow">&#9660;</span> Filters
      </button>
      <div class="filter-bar-body" id="filter-bar-body">
        <div class="filter-row">
          {% include "filter-bar.njk" %}
        </div>
        <div class="active-filters" id="active-filters"></div>
      </div>
    </section>

    <section>

      <div class="results-count" id="results-count"></div>
      <div class="room-grid" id="room-list">
        {% from "room-card.njk" import roomCard %}
        {% for room in catalog.rooms | reverse %}
          {{ roomCard(room) }}
        {% endfor %}
      </div>
    </section>
  </main>
{% endblock %}

{% block scripts %}
  <script>
    (function() {
      var hash = window.location.hash.slice(1);
      if (hash && hash.startsWith('rec')) {
        var card = document.getElementById(hash);
        if (card) {
          var link = card.querySelector('.room-card-link');
          if (link) { window.location.replace(link.href); return; }
        }
      }
    })();
  </script>
  <script id="room-index-data" type="application/json">{{ roomIndex | dump | safe }}</script>
  <script type="module" src="{{ '/js/list.js' | cacheBust }}"></script>
{% endblock %}
