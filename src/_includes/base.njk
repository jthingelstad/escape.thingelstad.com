<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block pageTitle %}{{ title }}{% endblock %} - Escaping Things</title>
  <meta name="description" content="{% block metaDescription %}{{ description }}{% endblock %}">
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" title="Escaping Things" href="/feed.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="{{ '/css/style.css' | cacheBust }}">
  {% block head %}{% endblock %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  {% include "nav.njk" %}

  {% block content %}{% endblock %}

  {% if showFooter !== false %}
  {% include "footer.njk" %}
  {% endif %}

  <script src="https://tinylytics.app/embed/jDupbLUKfFyNMs5d5WjD.js?kudos=👍&hits&countries&events" defer></script>
  {% block scripts %}{% endblock %}
</body>
</html>
