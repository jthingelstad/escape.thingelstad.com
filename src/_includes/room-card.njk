{#
  Shared room card macro — photo-backed room summary used across the site.
#}
{% macro roomCard(room, options) %}
{% set companyName = room.company.name if room.company else 'Unknown Company' %}
{% set fallbackImage = '/images/room-scheduled.png' if room.status == 'Scheduled' else '/images/room-no-photo.png' %}
{% set badgeLabel = options.badgeLabel if options and options.badgeLabel is defined else 'Room' %}
{% set badgeNumber = options.badgeNumber if options and options.badgeNumber is defined else room.id %}
{% set locationPrimary = '' %}
{% set locationSecondary = '' %}
{% if room.location %}
  {% if room.location.city %}
    {% set locationPrimary = room.location.city %}
    {% set locationSecondary = room.location.region or room.location.country or '' %}
  {% else %}
    {% set locationPrimary = room.location.label or room.location.country or room.location.region or 'Unknown Location' %}
    {% if room.location.country and room.location.country != locationPrimary %}
      {% set locationSecondary = room.location.country %}
    {% endif %}
  {% endif %}
{% endif %}
<div class="room-card{{ ' room-card-has-photo' if room.photo else ' room-card-no-photo' }}" id="{{ room.airtableId }}" data-room-id="{{ room.id }}" data-pagefind-ignore>
  <a href="{{ room | roomPath }}" class="room-card-link" data-tinylytics-event="card.view-room" data-tinylytics-event-value="{{ room.game }}">
    {% if room.photo %}
      <div class="room-card-thumb">
        <img src="/images/rooms/{{ room.photo }}" alt="" loading="lazy">
      </div>
    {% else %}
      <div class="room-card-fallback" aria-hidden="true">
        <img src="{{ fallbackImage }}" alt="" loading="lazy">
      </div>
    {% endif %}
    <div class="room-card-top-left">
      {% if badgeLabel and badgeNumber != null %}
      <div class="room-card-badge">
        <span class="room-card-badge-label">{{ badgeLabel }}</span>
        <span class="room-card-badge-number">{{ badgeNumber }}</span>
      </div>
      {% endif %}
    </div>
    <div class="room-card-top-right">
      {% if room.date %}
      <div class="room-card-date">{{ room.date | formatDate }}</div>
      {% endif %}
      {% if room.emojify %}
      <div class="room-card-emojify">{{ room.emojify }}</div>
      {% endif %}
    </div>
    <div class="room-card-bottom">
      <h3 class="room-card-room">{{ room.game }}</h3>
      <div class="room-card-company">{{ companyName }}</div>
      {% if (room.awards and room.awards.length) or (room.ratingSummary and room.ratingSummary.average) %}
      <div class="room-card-meta-row">
        {%- if room.awards and room.awards.length %}
        <span class="room-card-awards-inline">🏆 {{ room.awards.length }}</span>
        {%- endif %}
        {%- if room.ratingSummary and room.ratingSummary.average %}
        <span class="room-card-rating">{{ room.ratingSummary.average | starRating }}</span>
        {%- endif %}
      </div>
      {% endif %}
      <div class="room-card-bottom-right">
        {% if locationPrimary %}
        <div class="room-card-location-primary">{{ locationPrimary }}</div>
        {% endif %}
        {% if locationSecondary %}
        <div class="room-card-location-secondary">{{ locationSecondary }}</div>
        {% endif %}
      </div>
    </div>
  </a>
</div>
{% endmacro %}
