{#
  Room card macro — server-side rendered card linking to detail page
  Usage: {{ roomCard(room, { showRatingSummary: true }) }}
#}
{% macro roomCard(room, options) %}
{% set showRatingSummary = options.showRatingSummary if options else false %}
{% set showRoomNumber = options.showRoomNumber if options and options.showRoomNumber is defined else true %}
<div class="room-card{{ ' room-card-has-photo' if room.photo else ' room-card-no-photo' }}" id="{{ room.airtableId }}" data-room-id="{{ room.id }}">
  <a href="{{ room | roomPath }}" class="room-card-link" data-tinylytics-event="card.view-room" data-tinylytics-event-value="{{ room.game }}">
    {% if room.photo %}
      <div class="room-card-thumb">
        <img src="/images/rooms/{{ room.photo }}" alt="" loading="lazy">
      </div>
    {% else %}
      <div class="room-card-fallback" aria-hidden="true"></div>
    {% endif %}
    <div class="room-card-top">
      {% if showRoomNumber %}
      <span class="room-number">#{{ room.id }}</span>
      {% endif %}
      <span class="status-indicator">
        {% if room.status == "Escaped" %}
          <span class="status-badge status-escaped">✓ Escaped</span>
        {% elif room.status == "Try again" %}
          <span class="status-badge status-try-again">✗ Try Again</span>
        {% elif room.status == "Completed" %}
          <span class="status-badge status-completed">✓ Completed</span>
        {% elif room.status == "Scheduled" %}
          <span class="status-badge status-scheduled">Scheduled</span>
        {% endif %}
      </span>
    </div>
    <div class="room-card-body">
      <div class="room-card-title">
        <h3>{{ room.game }}</h3>
        <div class="room-card-company">{{ room.company.name if room.company else 'Unknown Company' }}</div>
      </div>
      <div class="room-card-meta">
        <span class="date"><span class="meta-icon">📅</span> {{ room.date | formatDate }}</span>
        {% set loc = room.location | formatLocation %}
        {% if loc %}
          <span class="location"><span class="meta-icon">📍</span> {{ loc }}</span>
        {% endif %}
      </div>
      {% if showRatingSummary and room.ratingSummary and room.ratingSummary.count > 0 %}
        <div class="room-card-ratings">
          {% if room.ratingSummary.average != null %}
            <span class="room-rating-pill room-rating-pill-score">{{ room.ratingSummary.average | formatRating }}/5</span>
          {% endif %}
          <span class="room-rating-pill">{{ room.ratingSummary.count }} rating{{ '' if room.ratingSummary.count == 1 else 's' }}</span>
          {% if room.ratingSummary.bestThingsCount > 0 %}
            <span class="room-rating-pill room-rating-pill-best">{{ room.ratingSummary.bestThingsCount }} favorite vote{{ '' if room.ratingSummary.bestThingsCount == 1 else 's' }}</span>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </a>
  <div class="room-card-footer">
    <button class="tinylytics_kudos room-kudos" data-path="/room/{{ room.airtableId }}"></button>
  </div>
</div>
{% endmacro %}
