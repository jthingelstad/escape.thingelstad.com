<nav class="main-nav">
  <div class="nav-container">
    <a href="/" class="nav-logo">Escaping Things</a>
    <button class="nav-search-btn" id="search-btn" aria-label="Search site">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </button>
    <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="site-nav">&#9776;</button>
    <ul class="nav-links" id="site-nav">
      {% if page.url != "/" %}<li><a href="/" data-tinylytics-event="nav.home">Home</a></li>{% endif %}
      <li><a href="/list/"{% if page.url == "/list/" %} class="active"{% endif %} data-tinylytics-event="nav.rooms">Rooms</a></li>
      <li><a href="/map/"{% if page.url == "/map/" %} class="active"{% endif %} data-tinylytics-event="nav.map">Map</a></li>
      <li><a href="/lists/"{% if page.url == "/lists/" or (page.url.startsWith("/list/") and page.url != "/list/") %} class="active"{% endif %} data-tinylytics-event="nav.lists">Lists</a></li>
      <li><a href="/trips/"{% if page.url == "/trips/" or page.url.startsWith("/trip/") %} class="active"{% endif %} data-tinylytics-event="nav.trips">Trips</a></li>
      <li><a href="/stats/"{% if page.url == "/stats/" %} class="active"{% endif %} data-tinylytics-event="nav.stats">Stats</a></li>
      <li><a href="/players/"{% if page.url == "/players/" or page.url.startsWith("/player/") %} class="active"{% endif %} data-tinylytics-event="nav.players">Players</a></li>
    </ul>
  </div>
</nav>

<div class="search-overlay" id="search-overlay" hidden>
  <div class="search-overlay-backdrop" id="search-overlay-backdrop"></div>
  <div class="search-overlay-panel">
    <button class="search-overlay-close" id="search-close" aria-label="Close search">&times;</button>
    <div id="pagefind-search"></div>
  </div>
</div>
