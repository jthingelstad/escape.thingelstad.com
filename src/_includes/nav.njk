      <li><a href="/featured/"{% if page.url == "/featured/" or page.url.startsWith("/player/") or page.url.startsWith("/award/") or page.url.startsWith("/trip/") %} class="active"{% endif %} data-tinylytics-event="nav.featured">Featured</a></li>
