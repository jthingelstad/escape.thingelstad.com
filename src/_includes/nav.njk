<nav class="main-nav">
  <div class="nav-container">
    <a href="/" class="nav-logo"{% if page.url == "/" %} aria-current="page"{% endif %}>Escaping Things</a>
    <button class="nav-search-btn" id="search-btn" aria-label="Search site" title="Search (/ or ⌘K)" data-tinylytics-event="nav.search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </button>
    <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="site-nav">&#9776;</button>
    <ul class="nav-links" id="site-nav">
      {% if page.url != "/" %}<li><a href="/" data-tinylytics-event="nav.home">Home</a></li>{% endif %}
      {% set roomsActive = page.url == "/rooms/" or page.url.startsWith("/room/") %}
      {% set mapActive = page.url == "/map/" %}
      {% set listsActive = page.url == "/lists/" or page.url.startsWith("/list/") %}
      {% set tripsActive = page.url == "/trips/" or page.url.startsWith("/trip/") %}
      {% set statsActive = page.url == "/stats/" %}
      {% set playersActive = page.url == "/players/" or page.url.startsWith("/player/") %}
      <li><a href="/rooms/"{% if roomsActive %} class="active" aria-current="page"{% endif %} data-tinylytics-event="nav.rooms">Rooms</a></li>
      <li><a href="/map/"{% if mapActive %} class="active" aria-current="page"{% endif %} data-tinylytics-event="nav.map">Map</a></li>
      <li><a href="/lists/"{% if listsActive %} class="active" aria-current="page"{% endif %} data-tinylytics-event="nav.lists">Lists</a></li>
      <li><a href="/trips/"{% if tripsActive %} class="active" aria-current="page"{% endif %} data-tinylytics-event="nav.trips">Trips</a></li>
      <li><a href="/stats/"{% if statsActive %} class="active" aria-current="page"{% endif %} data-tinylytics-event="nav.stats">Stats</a></li>
      <li><a href="/players/"{% if playersActive %} class="active" aria-current="page"{% endif %} data-tinylytics-event="nav.players">Players</a></li>
    </ul>
  </div>
</nav>

<div class="search-overlay" id="search-overlay" role="dialog" aria-modal="true" aria-label="Site search" hidden>
  <div class="search-overlay-backdrop" id="search-overlay-backdrop"></div>
  <div class="search-overlay-panel">
    <button class="search-overlay-close" id="search-close" aria-label="Close search">&times;</button>
    <div id="pagefind-search"></div>
    <div class="search-overlay-actions">
      <a href="/search/" class="btn" id="search-page-link">Open shareable search</a>
      <p class="search-hint">Press <kbd>?</kbd> for all keyboard shortcuts</p>
    </div>
  </div>
</div>

<div class="shortcuts-overlay" id="shortcuts-overlay" role="dialog" aria-modal="true" aria-labelledby="shortcuts-title" hidden>
  <div class="shortcuts-overlay-backdrop" id="shortcuts-overlay-backdrop"></div>
  <div class="shortcuts-overlay-panel">
    <button class="shortcuts-overlay-close" id="shortcuts-close" aria-label="Close shortcuts">&times;</button>
    <h2 id="shortcuts-title">Keyboard Shortcuts</h2>
    <div class="shortcuts-group">
      <h3>Global</h3>
      <dl class="shortcuts-list">
        <div class="shortcut-row"><dt><kbd>/</kbd> or <kbd>⌘K</kbd></dt><dd>Open search</dd></div>
        <div class="shortcut-row"><dt><kbd>?</kbd></dt><dd>Show this help</dd></div>
        <div class="shortcut-row"><dt><kbd>Esc</kbd></dt><dd>Close overlay</dd></div>
      </dl>
    </div>
    <div class="shortcuts-group">
      <h3>Navigation</h3>
      <dl class="shortcuts-list">
        <div class="shortcut-row"><dt><kbd>g</kbd> <kbd>h</kbd></dt><dd>Home</dd></div>
        <div class="shortcut-row"><dt><kbd>g</kbd> <kbd>r</kbd></dt><dd>Rooms</dd></div>
        <div class="shortcut-row"><dt><kbd>g</kbd> <kbd>m</kbd></dt><dd>Map</dd></div>
        <div class="shortcut-row"><dt><kbd>g</kbd> <kbd>l</kbd></dt><dd>Lists</dd></div>
        <div class="shortcut-row"><dt><kbd>g</kbd> <kbd>t</kbd></dt><dd>Trips</dd></div>
        <div class="shortcut-row"><dt><kbd>g</kbd> <kbd>s</kbd></dt><dd>Stats</dd></div>
        <div class="shortcut-row"><dt><kbd>g</kbd> <kbd>p</kbd></dt><dd>Players</dd></div>
      </dl>
    </div>
  </div>
</div>
