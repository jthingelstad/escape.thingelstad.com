---
title: Map
description: Explore escape room locations on an interactive map.
permalink: /map/
showFooter: false
---
{% extends "base.njk" %}

{% block head %}
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css">
{% endblock %}

{% block content %}
  <main class="map-page" id="main-content" data-pagefind-ignore>
    <div class="map-summary-bar">
      <span id="map-results" aria-live="polite">Loading room locations…</span>
      <a href="/rooms/" class="map-summary-link" id="map-view-link">List view</a>
      <button class="map-summary-link" type="button" data-copy-link><span data-copy-label>Copy map</span></button>
    </div>

    <div class="map-legend" aria-label="Map marker legend">
      <span><i class="map-legend-dot status-escaped"></i>Escaped</span>
      <span><i class="map-legend-dot status-try-again"></i>Try Again</span>
      <span><i class="map-legend-dot status-completed"></i>Completed</span>
      <span><i class="map-legend-dot status-scheduled"></i>Scheduled</span>
    </div>

    <button class="map-filter-toggle" id="filter-toggle" type="button" aria-expanded="false" aria-controls="filter-panel" data-tinylytics-event="map.toggle-filters">
      <span class="toggle-arrow">&#9660;</span> Filters
      <span class="filter-count" id="filter-count" hidden>0</span>
    </button>

    <div class="filter-sheet-backdrop" id="filter-backdrop" hidden></div>
    <section class="map-filter-panel collapsed" id="filter-panel" aria-labelledby="map-filter-title">
      <div class="filter-sheet-header">
        <div>
          <div class="eyebrow">Refine the map</div>
          <h2 id="map-filter-title">Filters</h2>
        </div>
        <button class="filter-sheet-close" id="filter-close" type="button" aria-label="Close filters">&times;</button>
      </div>
      <div class="filter-row">
        <div class="filter-cluster">
          <div class="filter-cluster-grid">
            <div class="filter-group">
              <label for="filter-country">Country</label>
              <select id="filter-country">
                <option value="">All Countries</option>
                {% for country in filters.countries %}
                  <option value="{{ country }}">{{ country }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="filter-group">
              <label for="filter-trip">Trip</label>
              <select id="filter-trip">
                <option value="">All Trips</option>
                {% for trip in filters.trips %}
                  <option value="{{ trip.slug }}">{{ trip.label }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="filter-group">
              <label for="filter-list">List</label>
              <select id="filter-list">
                <option value="">All Lists</option>
                {% for list in filters.lists %}
                  <option value="{{ list.slug }}">{{ list.label }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="filter-group">
              <label for="filter-year">Year</label>
              <select id="filter-year">
                <option value="">All Years</option>
                {% for year in filters.years %}
                  <option value="{{ year }}">{{ year }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="filter-group">
              <label for="filter-status">Status</label>
              <select id="filter-status">
                <option value="all">All</option>
                <option value="Escaped">Escaped</option>
                <option value="Try again">Try Again</option>
                <option value="Completed">Completed</option>
                <option value="Scheduled">Scheduled</option>
              </select>
            </div>
          </div>
          <div class="filter-actions">
            <button class="btn btn-clear" id="clear-filters" hidden data-tinylytics-event="filter.clear-all">Clear All</button>
            <button class="btn btn-teal filter-apply" id="filter-apply" type="button">Show rooms</button>
          </div>
        </div>
      </div>
    </section>

    <div id="map"></div>
  </main>
{% endblock %}

{% block scripts %}
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
  <script id="room-index-data" type="application/json">{{ roomIndex | dump | safe }}</script>
  <script type="module" src="{{ '/js/map.js' | cacheBust }}"></script>
{% endblock %}
