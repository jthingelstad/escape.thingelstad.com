---
pagination:
  data: legacyRooms
  size: 1
  alias: redirect
  addAllPagesToCollections: false
permalink: /room/{{ redirect.from }}/index.html
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Moving to {{ redirect.room.game }} — Escaping Things</title>
  <meta name="robots" content="noindex">
  <meta http-equiv="refresh" content="0; url={{ redirect.room | roomPath }}">
  <link rel="canonical" href="https://escape.thingelstad.com{{ redirect.room | roomPath }}">
  <script>window.location.replace("{{ redirect.room | roomPath }}" + window.location.search + window.location.hash);</script>
</head>
<body>
  <p>This room has moved to <a href="{{ redirect.room | roomPath }}">{{ redirect.room.game }}</a>.</p>
</body>
</html>
