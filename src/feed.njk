---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>Escaping Things — Recent Rooms</title>
  <subtitle>New escape rooms played by the Escaping Things team, with results, photos, and reflections.</subtitle>
  <link href="https://escape.thingelstad.com/" rel="alternate" type="text/html"/>
  <link href="https://escape.thingelstad.com/feed.xml" rel="self" type="application/atom+xml"/>
  <id>https://escape.thingelstad.com/</id>
  {%- if feed.updatedAt %}
  <updated>{{ feed.updatedAt }}</updated>
  {%- endif %}
  <author>
    <name>Escaping Things</name>
    <uri>https://escape.thingelstad.com/</uri>
  </author>
  <icon>https://escape.thingelstad.com/images/favicon.svg</icon>
  <generator uri="https://www.11ty.dev/">Eleventy</generator>
  <rights>Content licensed under CC BY-SA 4.0.</rights>
  {%- for entry in feed.entries %}
  <entry>
    <title>{{ entry.title | e }}</title>
    <link href="{{ entry.url | e }}" rel="alternate" type="text/html"/>
    <id>{{ entry.id | e }}</id>
    <published>{{ entry.publishedAt }}</published>
    <updated>{{ entry.updatedAt }}</updated>
    <summary type="text">{{ entry.summary | e }}</summary>
    <category term="{{ entry.room.status | e }}" label="{{ entry.room.status | e }}"/>
    {%- if entry.room.location and entry.room.location.country %}
    <category term="{{ entry.room.location.country | e }}" label="{{ entry.room.location.country | e }}"/>
    {%- endif %}
    <content type="html"><![CDATA[
{% include "feed-entry-content.njk" %}    ]]></content>
  </entry>
  {%- endfor %}
</feed>
