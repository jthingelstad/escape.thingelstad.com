---
pagination:
  data: playerPages
  size: 1
  alias: player
  addAllPagesToCollections: true
permalink: /player/{{ player.slug }}/
---
{% extends "base.njk" %}

{% block pageTitle %}{{ player.name }} — Featured Player{% endblock %}
{% block metaDescription %}Featured player page for {{ player.name }} with room history, recent plays, and notes.{% endblock %}
{% block socialTitle %}{{ player.name }} — Featured Player - Escaping Things{% endblock %}
{% block socialDescription %}Explore {{ player.name }}'s escape room history, recent notes, lists, and team statistics.{% endblock %}

{% block content %}
  <main class="container page-content featured-detail-page" id="main-content" data-pagefind-body data-pagefind-meta="type:player">
    <section class="featured-detail-hero">
      <div>
        <div class="eyebrow">Featured player</div>
        <h1>{{ player.name }}</h1>
        {% if player.bio %}
        <div class="featured-detail-copy rich-text">{{ player.bio | richText | safe }}</div>
        {% endif %}
      </div>
      <div class="featured-detail-stats">
        <div class="stat-item"><span class="stat-number">{{ player.roomCount }}</span><div class="stat-label">Rooms</div></div>
        <div class="stat-item"><span class="stat-number">{{ player.wins }}</span><div class="stat-label">Wins</div></div>
        <div class="stat-item"><span class="stat-number">{{ player.winRate }}%</span><div class="stat-label">Win Rate</div></div>
      </div>
    </section>

    {% if player.lists.length > 0 %}
    <section id="lists">
      <div class="section-header">
        <h2 data-pagefind-ignore>Lists <a class="heading-anchor" href="#lists" aria-label="Link to Lists">#</a></h2>
      </div>
      <div class="list-summary-grid">
        {% for list in player.lists %}
        <a href="{{ list | entityUrl('list') }}" class="list-summary-card" data-tinylytics-event="player.list" data-tinylytics-event-value="{{ list.name }}">
          <div class="feature-tile-kicker">List</div>
          <h3>{{ list.name }}</h3>
          <p>{{ list.roomCount }} room{{ '' if list.roomCount == 1 else 's' }}</p>
        </a>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {% if player.comments.length > 0 %}
    <section class="featured-quotes-section" id="recent-notes">
      <div class="section-header">
        <h2 data-pagefind-ignore>Recent Notes <a class="heading-anchor" href="#recent-notes" aria-label="Link to Recent Notes">#</a></h2>
      </div>
      <div class="featured-quote-grid">
        {% for experience in player.comments %}
          {% set room = catalog.lookups.rooms.byAirtableId[experience.roomAirtableId] %}
          <article class="featured-quote-card">
            <h3>{% if room %}<a href="{{ room | roomPath }}">{{ room.game }}</a>{% else %}Room Note{% endif %}</h3>
            {% if room and room.company %}
            <div class="featured-quote-meta">{{ room.company.name }} • {{ room.date | formatDate }}</div>
            {% endif %}
            <div class="rich-text">{{ experience.comments | richText | safe }}</div>
          </article>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <section id="recent-rooms">
      <div class="section-header section-header-with-link">
        <div>
          <h2 data-pagefind-ignore>Recent Rooms <a class="heading-anchor" href="#recent-rooms" aria-label="Link to Recent Rooms">#</a></h2>
          <p>The latest rooms with {{ player.name }}. The complete history stays available in the room browser.</p>
        </div>
        <a class="section-more-link" href="/rooms/?player={{ player.slug | queryValue }}">Browse linked rooms →</a>
      </div>
      {% if player.recentRooms.length > 0 %}
      <div class="room-grid">
        {% from "room-card.njk" import roomCard %}
        {% for room in player.recentRooms %}
          {{ roomCard(room, { returnPath: page.url }) }}
        {% endfor %}
      </div>
      {% else %}
      <div class="empty-state-card">
        <p>No public rooms are attached to this featured player yet.</p>
      </div>
      {% endif %}
    </section>

  </main>
{% endblock %}

{% block scripts %}
  <script type="module">
    import { initNav } from '{{ '/js/data.js' | cacheBust }}';
    initNav();
  </script>
{% endblock %}
