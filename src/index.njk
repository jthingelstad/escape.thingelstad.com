---
title: The Thingelstad Family Escape Room Journey
description: The Thingelstad family's escape room journey.
permalink: /index.html
bodyClass: page-home
---
{% extends "base.njk" %}

{% block content %}
  <main class="container page-content">
    <section class="hero">
      <h1>Escaping Things</h1>
      <p class="subtitle">The Thingelstad Family Escape Room Journey</p>
      <nav class="hero-nav" aria-label="Quick navigation">
        <a href="/list/" class="hero-nav-pill" data-tinylytics-event="nav.rooms">Rooms</a>
        <a href="/scrapbook/" class="hero-nav-pill" data-tinylytics-event="nav.scrapbook">Scrapbook</a>
        <a href="/map/" class="hero-nav-pill" data-tinylytics-event="nav.map">Map</a>
        <a href="/stats/" class="hero-nav-pill" data-tinylytics-event="nav.stats">Stats</a>
      </nav>
      <div class="stats-row" id="hero-stats">
        <div class="stat-item"><span class="stat-number">{{ stats.totalRooms }}</span><div class="stat-label">Rooms</div></div>
        <div class="stat-item"><span class="stat-number">{{ stats.totalWins }}</span><div class="stat-label">Wins</div></div>
        <div class="stat-item"><span class="stat-number">{{ stats.winRate }}%</span><div class="stat-label">Win Rate</div></div>
        <div class="stat-item"><span class="stat-number">{{ stats.regionCount }}</span><div class="stat-label">Regions</div></div>
        <div class="stat-item"><span class="stat-number">{{ stats.countryCount }}</span><div class="stat-label">Countries</div></div>
        <div class="stat-item"><span class="stat-number">{{ stats.yearsActive }}</span><div class="stat-label">Years Active</div></div>
      </div>
    </section>

    {% if stats.recentCompleted and stats.recentCompleted.length > 0 %}
    <section id="recent-rooms">
      <div class="section-header">
        <h2>Recent Rooms</h2>
      </div>
      <div class="room-grid">
        {% from "room-card.njk" import roomCard %}
        {% for room in stats.recentCompleted %}
          {{ roomCard(room) }}
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {% if stats.planned.length > 0 %}
    <section id="upcoming-section">
      <div class="section-header">
        <h2>Coming Up</h2>
      </div>
      <div class="room-grid">
        {% from "room-card.njk" import roomCard %}
        {% for room in stats.planned %}
          {{ roomCard(room) }}
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <section class="puzzle-trail">
      <div class="section-header">
        <h2>Escape Trail</h2>
      </div>
      <div class="trail-grid">
        <a href="/map/" class="trail-card" data-tinylytics-event="card.trail-map">
          <img class="trail-icon" src="/images/key.svg" alt="Key icon">
          <h3>Explore the Map</h3>
          <p>Every city where we've taken on a room, pinned on a dark map.</p>
        </a>
        <a href="/list/" class="trail-card" data-tinylytics-event="card.trail-rooms">
          <img class="trail-icon" src="/images/puzzle.svg" alt="Puzzle icon">
          <h3>Browse All Rooms</h3>
          <p>Filter and sort every room by company, year, players, and more.</p>
        </a>
        <a href="/scrapbook/" class="trail-card" data-tinylytics-event="card.trail-scrapbook">
          <img class="trail-icon" src="/images/camera.svg" alt="Camera icon">
          <h3>Flip Through Photos</h3>
          <p>Our room photos scattered like polaroids on a table.</p>
        </a>
        <a href="/stats/" class="trail-card" data-tinylytics-event="card.trail-stats">
          <img class="trail-icon" src="/images/lock.svg" alt="Lock icon">
          <h3>See the Stats</h3>
          <p>Charts and numbers behind our escape room obsession.</p>
        </a>
      </div>
    </section>


  </main>
{% endblock %}

{% block scripts %}
  <script type="module">
    import { initNav } from '{{ '/js/data.js' | cacheBust }}';
    initNav();
  </script>
{% endblock %}
