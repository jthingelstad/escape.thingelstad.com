---
title: The Thingelstad Family Escape Room Journey
description: The Thingelstad family's escape room journey.
permalink: /index.html
bodyClass: page-home
---
{% extends "base.njk" %}

{% block content %}
  <main class="container page-content">
    <section class="page-intro">
      <div class="eyebrow">Family Archive</div>
      <div class="page-intro-copy">
        <h1 class="page-intro-title">Escaping Things</h1>
        <p>{{ ai.copy.home.summary or "The Thingelstad family’s escape room history, rebuilt as a calmer travel-and-room archive with routes, ratings, places, and the standout stories threaded through it." }}</p>
      </div>
      <div class="stats-row" id="hero-stats">
        <div class="stat-item"><span class="stat-number">{{ stats.totalRooms }}</span><div class="stat-label">Rooms</div></div>
        <div class="stat-item"><span class="stat-number">{{ stats.totalWins }}</span><div class="stat-label">Wins</div></div>
        <div class="stat-item"><span class="stat-number">{{ stats.winRate }}%</span><div class="stat-label">Win Rate</div></div>
        <div class="stat-item"><span class="stat-number">{{ stats.regionCount }}</span><div class="stat-label">Regions</div></div>
        <div class="stat-item"><span class="stat-number">{{ stats.countryCount }}</span><div class="stat-label">Countries</div></div>
        <div class="stat-item"><span class="stat-number">{{ stats.yearsActive }}</span><div class="stat-label">Years Active</div></div>
      </div>
      <div class="action-row">
        <a href="/list/" class="action-link" data-tinylytics-event="home.view-list">Browse Room Archive</a>
        <a href="/map/" class="action-link" data-tinylytics-event="home.view-map">See the Map</a>
        <a href="/lists/" class="action-link" data-tinylytics-event="home.view-lists">Browse Curated Lists</a>
      </div>
    </section>

    {% if stats.recentCompleted and stats.recentCompleted.length > 0 %}
    <section id="recent-rooms">
      <div class="section-header">
        <h2>Recent Rooms</h2>
        <p>The latest dozen rooms in the archive.</p>
      </div>
      <div class="room-grid">
        {% from "room-card.njk" import roomCard %}
        {% for room in stats.recentCompleted %}
          {{ roomCard(room) }}
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <section class="featured-entities-section">
      <div class="section-header">
        <h2>Featured Paths</h2>
        <p>Trips, awards, and players with their own story on the site.</p>
      </div>
      <div class="featured-entity-grid">
        {% for trip in catalog.featured.trips %}
          <a href="{{ trip | entityUrl('trip') }}" class="feature-tile feature-tile-trip" data-tinylytics-event="home.featured-trip" data-tinylytics-event-value="{{ trip.name }}">
            <div class="feature-tile-kicker">Trip</div>
            <h3>{{ trip.name }}</h3>
            <p>{{ trip.roomCount }} room{{ '' if trip.roomCount == 1 else 's' }}</p>
          </a>
        {% endfor %}
        {% for award in catalog.featured.awards %}
          <a href="{{ award | entityUrl('award') }}" class="feature-tile feature-tile-award" data-tinylytics-event="home.featured-award" data-tinylytics-event-value="{{ award.name }}">
            <div class="feature-tile-kicker">Award</div>
            <h3>{{ award.name }}</h3>
            <p>{{ award.roomCount }} room{{ '' if award.roomCount == 1 else 's' }}</p>
          </a>
        {% endfor %}
        {% for player in catalog.featured.players %}
          <a href="{{ player | entityUrl('player') }}" class="feature-tile feature-tile-player" data-tinylytics-event="home.featured-player" data-tinylytics-event-value="{{ player.name }}">
            <div class="feature-tile-kicker">Player</div>
            <h3>{{ player.name }}</h3>
            <p>{{ player.roomCount }} room{{ '' if player.roomCount == 1 else 's' }}</p>
          </a>
        {% endfor %}
      </div>
    </section>
  </main>
{% endblock %}

{% block scripts %}
  <script type="module">
    import { initNav } from '{{ '/js/data.js' | cacheBust }}';
    initNav();
  </script>
{% endblock %}
