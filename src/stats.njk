---
title: Stats
description: Charts and statistics about our escape room adventures.
permalink: /stats/
---
{% extends "base.njk" %}

{% block content %}
  <main class="container page-content stats-page">
    <section>
      <div class="section-header">
        <h2>Stats</h2>
        <p>A richer look at the collection through the people, themes, trips, awards, and room outcomes behind it.</p>
      </div>

      <div class="stats-row" id="summary-stats">
        <div class="stat-item"><span class="stat-number">{{ stats.totalRooms }}</span><div class="stat-label">Played</div></div>
        <div class="stat-item"><span class="stat-number">{{ stats.scheduledRooms }}</span><div class="stat-label">Scheduled</div></div>
        <div class="stat-item"><span class="stat-number">{{ stats.winRate }}%</span><div class="stat-label">Win Rate</div></div>
        <div class="stat-item"><span class="stat-number">{{ stats.countryCount }}</span><div class="stat-label">Countries</div></div>
        <div class="stat-item"><span class="stat-number">{{ stats.uniquePlayerCount }}</span><div class="stat-label">Players</div></div>
        <div class="stat-item"><span class="stat-number">{{ stats.currentWinStreak }}</span><div class="stat-label">Current Streak</div></div>
        <div class="stat-item"><span class="stat-number">{{ stats.averageTeamSize if stats.averageTeamSize != null else '—' }}</span><div class="stat-label">Avg Team Size</div></div>
        <div class="stat-item"><span class="stat-number">{{ (stats.averageRating | formatRating) if stats.averageRating != null else '—' }}</span><div class="stat-label">Avg Rating</div></div>
      </div>

      <div class="stats-insight-grid">
        <article class="stats-insight-card">
          <div class="feature-tile-kicker">Momentum</div>
          <h3>{{ stats.insights.momentum.currentWinStreak }} straight wins</h3>
          <p>Longest streak: {{ stats.insights.momentum.longestWinStreak }} rooms across {{ stats.insights.momentum.yearsActive }} active years.</p>
        </article>
        <article class="stats-insight-card">
          <div class="feature-tile-kicker">Cast</div>
          <h3>{{ stats.insights.cast.uniquePlayers }} players logged</h3>
          <p>{% if stats.insights.cast.topPlayer %}{{ stats.insights.cast.topPlayer.label }} appears most often with {{ stats.insights.cast.topPlayer.count }} rooms.{% else %}Player appearance data is still growing.{% endif %}{% if stats.topTheme %} Most common theme: {{ stats.topTheme.label }}.{% endif %}</p>
        </article>
        <article class="stats-insight-card">
          <div class="feature-tile-kicker">Curation</div>
          <h3>{{ stats.insights.curation.roomsWithAwards }} award-tagged rooms</h3>
          <p>{{ stats.insights.curation.roomsWithTrips }} rooms are part of trips and {{ stats.insights.curation.roomsWithLists }} appear on curated lists.</p>
        </article>
        <article class="stats-insight-card">
          <div class="feature-tile-kicker">Ratings</div>
          <h3>{{ stats.insights.ratings.ratedRoomCount }} rated rooms</h3>
          <p>{% if stats.insights.ratings.averageRating != null %}Average score is {{ stats.insights.ratings.averageRating | formatRating }}/5 with {{ stats.insights.ratings.favoriteVoteCount }} favorite votes logged.{% else %}Ratings will appear here as review data grows.{% endif %}</p>
        </article>
      </div>

      <div class="charts-grid">
        <div class="chart-card full-width">
          <h3>Time Left</h3>
          <p class="chart-subtitle">Higher is better. Negative values indicate going over time. Striped bars exceeded the chart floor.</p>
          <canvas id="chart-times"></canvas>
        </div>

        <div class="chart-card">
          <h3>Rooms Per Year</h3>
          <p class="chart-subtitle">A long view of volume and outcomes by year.</p>
          <canvas id="chart-rooms-year"></canvas>
        </div>

        <div class="chart-card">
          <h3>Monthly Distribution</h3>
          <p class="chart-subtitle">When during the year the rooms tend to happen.</p>
          <canvas id="chart-monthly"></canvas>
        </div>

        <div class="chart-card">
          <h3>Rooms by State</h3>
          <p class="chart-subtitle">Still a strong part of the history, especially in the early years.</p>
          <canvas id="chart-states"></canvas>
        </div>

        <div class="chart-card">
          <h3>Rooms by Country</h3>
          <p class="chart-subtitle">The broader travel footprint of the collection.</p>
          <canvas id="chart-countries"></canvas>
        </div>

        <div class="chart-card">
          <h3>Most Active Players</h3>
          <p class="chart-subtitle">A better fit than companies now that the people and trips are first-class data.</p>
          <canvas id="chart-players"></canvas>
        </div>
      </div>
    </section>
  </main>
{% endblock %}

{% block scripts %}
  <script id="chart-data" type="application/json">{{ stats.charts | dump | safe }}</script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <script type="module" src="{{ '/js/stats.js' | cacheBust }}"></script>
{% endblock %}
