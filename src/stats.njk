---
title: Stats
description: Charts and statistics about our escape room adventures.
permalink: /stats/
---
{% extends "base.njk" %}

{% block content %}
  <main class="container page-content stats-page" data-pagefind-ignore>
    <section class="page-intro">
      <div class="page-intro-copy">
        <h1 class="page-intro-title">Stats</h1>
        <p>A richer look at the collection through the people, themes, trips, awards, and room outcomes behind it.</p>
      </div>
    </section>

    <section>
      <div class="charts-grid">
        <div class="chart-card chart-card-time full-width">
          <h3>Cumulative Rooms</h3>
          <p class="chart-subtitle">Running total colored by outcome. Green for wins, red for losses — longer runs show streaks.</p>
          <div class="chart-canvas-wrap chart-canvas-wrap-time">
            <canvas id="chart-cumulative"></canvas>
          </div>
        </div>

        <div class="chart-card chart-card-time full-width">
          <h3>Time Left</h3>
          <p class="chart-subtitle">Higher is better. Negative values indicate going over time. Striped bars exceeded the chart floor.</p>
          <div class="chart-canvas-wrap chart-canvas-wrap-time">
            <canvas id="chart-times"></canvas>
          </div>
        </div>

        <div class="chart-card chart-card-standard">
          <h3>Rooms Per Year</h3>
          <p class="chart-subtitle">A long view of volume and outcomes by year.</p>
          <div class="chart-canvas-wrap chart-canvas-wrap-standard">
            <canvas id="chart-rooms-year"></canvas>
          </div>
        </div>

        <div class="chart-card chart-card-standard">
          <h3>Monthly Distribution</h3>
          <p class="chart-subtitle">When during the year the rooms tend to happen.</p>
          <div class="chart-canvas-wrap chart-canvas-wrap-standard">
            <canvas id="chart-monthly"></canvas>
          </div>
        </div>

        <div class="chart-card chart-card-standard">
          <h3>Rooms by State</h3>
          <p class="chart-subtitle">Still a strong part of the history, especially in the early years.</p>
          <div class="chart-canvas-wrap chart-canvas-wrap-standard">
            <canvas id="chart-states"></canvas>
          </div>
        </div>

        <div class="chart-card chart-card-standard">
          <h3>Rooms by Country</h3>
          <p class="chart-subtitle">The broader travel footprint of the collection.</p>
          <div class="chart-canvas-wrap chart-canvas-wrap-standard">
            <canvas id="chart-countries"></canvas>
          </div>
        </div>

        <div class="chart-card chart-card-standard">
          <h3>Most Active Players</h3>
          <p class="chart-subtitle">A better fit than companies now that the people and trips are first-class data.</p>
          <div class="chart-canvas-wrap chart-canvas-wrap-standard">
            <canvas id="chart-players"></canvas>
          </div>
        </div>

        <div class="chart-card chart-card-standard">
          <h3>Rooms by Theme</h3>
          <p class="chart-subtitle">The most common themes across the collection.</p>
          <div class="chart-canvas-wrap chart-canvas-wrap-standard">
            <canvas id="chart-themes"></canvas>
          </div>
        </div>

        <div class="chart-card chart-card-standard">
          <h3>Rooms by Award</h3>
          <p class="chart-subtitle">Awards assigned to rooms in the collection.</p>
          <div class="chart-canvas-wrap chart-canvas-wrap-standard">
            <canvas id="chart-awards"></canvas>
          </div>
        </div>

        <div class="chart-card chart-card-standard">
          <h3>Rating Distribution</h3>
          <p class="chart-subtitle">How room ratings spread across the scale.</p>
          <div class="chart-canvas-wrap chart-canvas-wrap-standard">
            <canvas id="chart-ratings"></canvas>
          </div>
        </div>

        <div class="chart-card full-width">
          <h3>Rooms by State</h3>
          <p class="chart-subtitle">Distribution across U.S. states.</p>
          <div class="chart-canvas-wrap" style="height: 420px">
            <canvas id="chart-state-choropleth"></canvas>
          </div>
        </div>

        <div class="chart-card full-width">
          <h3>Rooms by Country</h3>
          <p class="chart-subtitle">Geographic distribution of rooms played around the world.</p>
          <div class="chart-canvas-wrap" style="height: 420px">
            <canvas id="chart-choropleth"></canvas>
          </div>
        </div>
      </div>
    </section>
  </main>
{% endblock %}

{% block scripts %}
  <script id="chart-data" type="application/json">{{ stats.charts | dump | safe }}</script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/topojson-client@3.1.0/dist/topojson-client.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-chart-geo@4.1.2/build/index.umd.min.js"></script>
  <script type="module" src="{{ '/js/stats.js' | cacheBust }}"></script>
{% endblock %}
