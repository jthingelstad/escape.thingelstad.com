---
pagination:
  data: roomDetail
  size: 1
  alias: room
  addAllPagesToCollections: true
permalink: /room/{{ room.slug }}/
---
{% extends "base.njk" %}
{% from "room-card.njk" import roomCard %}
{% from "entity-chips.njk" import entityGroup %}

{% block pageTitle %}{{ room.game | safe }} — {{ room.company.name if room.company else 'Unknown Company' }}{% endblock %}
{% block metaDescription %}{{ room.game | safe }} at {{ room.company.name if room.company else 'Unknown Company' }}{% if room.location %}, {{ room.location | formatLocation | safe }}{% endif %}. {{ room.status | safe }}{% if room.timeLeft != null %} with {{ room.timeLeft | formatTimeLeft | safe }}{% endif %}.{% endblock %}

{% block head %}
  <meta property="og:title" content="{{ room.game }} — {{ room.company.name if room.company else 'Unknown Company' }} - Escaping Things">
  <meta property="og:description" content="{{ room.game }} at {{ room.company.name if room.company else 'Unknown Company' }}{% if room.location %}, {{ room.location | formatLocation }}{% endif %}. {{ room.status }}{% if room.timeLeft != null %} with {{ room.timeLeft | formatTimeLeft }}{% endif %}.">
  <meta property="og:type" content="article">
  <meta property="og:url" content="https://escape.thingelstad.com{{ room | roomPath }}">
  {% if room.photo %}
  <meta property="og:image" content="https://escape.thingelstad.com/images/rooms/{{ room.photo }}">
  {% else %}
  <meta property="og:image" content="https://escape.thingelstad.com/images/favicon.svg">
  {% endif %}
  <meta property="og:site_name" content="Escaping Things">
  <meta name="twitter:card" content="summary_large_image">
{% endblock %}

{% block content %}
  <main class="container page-content room-detail-page" data-pagefind-body data-pagefind-meta="title:{{ room.game | safe }}{% if room.company %}, company:{{ room.company.name }}{% endif %}">
    <section class="room-hero">
      {% if room.photo %}
      <div class="room-hero-photo">
        <img src="/images/rooms/{{ room.photo }}" alt="{{ room.game }} at {{ room.company.name if room.company else 'Unknown Company' }}">
      </div>
      {% endif %}
      <div class="room-hero-info">
        <div class="room-hero-header">
          <span class="room-number">#{{ room.id }}</span>
          <h1>{{ room.game }}</h1>
        </div>
        {% if room.company %}
        <div class="room-hero-company">
          <a href="{{ room.company | entityFilterUrl('company') }}" data-tinylytics-event="room.company-filter" data-tinylytics-event-value="{{ room.company.name }}">{{ room.company.name }}</a>
        </div>
        {% endif %}
        <div class="room-hero-meta">
          <span class="room-hero-meta-item">
            <span class="meta-icon">📅</span> {{ room.date | formatDate }}
          </span>
        </div>

        <div class="room-hero-status-row">
          {% if room.status == "Escaped" %}
            <span class="status-badge status-escaped">✓ Escaped</span>
          {% elif room.status == "Try again" %}
            <span class="status-badge status-try-again">✗ Try Again</span>
          {% elif room.status == "Completed" %}
            <span class="status-badge status-completed">✓ Completed</span>
          {% elif room.status == "Scheduled" %}
            <span class="status-badge status-scheduled">Scheduled</span>
          {% endif %}
          {% if room.timeLeft != null %}
            <span class="room-hero-time">
              <span class="meta-icon">⏱</span> {{ room.timeLeft | formatTimeLeft }}
            </span>
          {% endif %}
        </div>

        {% if room.players and room.players.length > 0 %}
        <div class="room-hero-players">
          <span class="meta-icon">👥</span>
          {% for player in room.players %}
            <a href="{{ player | entityUrl('player') }}" data-tinylytics-event="room.player" data-tinylytics-event-value="{{ player.name }}">{{ player.name }}</a>{% if not loop.last %}, {% endif %}
          {% endfor %}
        </div>
        {% endif %}

        <div class="room-hero-entities">
          {{ entityGroup('Lists', room.lists, 'list', 'room.list') }}
          {{ entityGroup('Awards', room.awards, 'award', 'room.award') }}
          {{ entityGroup('Trips', room.trips, 'trip', 'room.trip') }}
          {{ entityGroup('Themes', room.themes, 'theme', 'room.theme') }}
        </div>

        {% if room.commentary %}
        <div class="room-hero-commentary rich-text">{{ room.commentary | richText | safe }}</div>
        {% endif %}

        {% if room.notes %}
        <div class="room-hero-notes rich-text">{{ room.notes | richText | safe }}</div>
        {% endif %}

        <div class="room-hero-links">
          {% if room.officialUrl %}
            <a href="{{ room.officialUrl }}" class="room-link room-link-official" target="_blank" rel="noopener" data-tinylytics-event="room.official-site" data-tinylytics-event-value="{{ room.game }}">
              Official Site &rarr;
            </a>
          {% endif %}
          {% if room.blogUrl %}
            <a href="{{ room.blogUrl }}" class="room-link room-link-blog" target="_blank" rel="noopener" data-tinylytics-event="room.blog-post" data-tinylytics-event-value="{{ room.game }}">
              Read Blog Post &rarr;
            </a>
          {% endif %}
          {% if room.mortyId %}
            <a href="https://morty.app/attraction/{{ room.mortyId }}" class="room-link room-link-morty" target="_blank" rel="noopener" data-tinylytics-event="room.morty" data-tinylytics-event-value="{{ room.game }}">
              View on Morty &rarr;
            </a>
          {% endif %}
        </div>

        <div class="room-hero-kudos">
          <button class="tinylytics_kudos room-kudos" data-path="/room/{{ room.airtableId }}"></button>
        </div>
      </div>
    </section>

    {% if room.status !== "Scheduled" %}
    <section class="room-stats-section">
      <div class="section-header">
        <h2>How We Did</h2>
        <p>A quick structural read on the result, the time, and how this room sits in the rest of the history.</p>
      </div>
      <div class="room-stats-grid">
            {% if room.timeLeft != null %}
            <div class="room-stat-card">
              <div class="room-stat-value{% if room.timeLeft >= 0 %} stat-positive{% else %} stat-negative{% endif %}">
                {{ room.timeLeft | formatTimeLeft }}
              </div>
              <div class="room-stat-label">Time Result</div>
              {% if room.stats.avgTimeLeft != null %}
              <div class="room-stat-compare">
                Avg across all rooms: {{ room.stats.avgTimeLeft | formatTimeLeft }}
              </div>
              {% endif %}
            </div>
            <div class="room-stat-card">
              <div class="room-stat-value">{{ room.stats.timePercentile }}%</div>
              <div class="room-stat-label">Time Percentile</div>
              <div class="room-stat-compare">
                {% if room.stats.timePercentile >= 75 %}
                  Top performer — better than most rooms
                {% elif room.stats.timePercentile >= 50 %}
                  Above average time result
                {% elif room.stats.timePercentile >= 25 %}
                  Below average time result
                {% else %}
                  A tough one — bottom quartile
                {% endif %}
              </div>
            </div>
            {% endif %}

            <div class="room-stat-card">
              <div class="room-stat-value">
                {% if room.status == "Escaped" or room.status == "Completed" %}
                  ✓ Win
                {% else %}
                  ✗ Loss
                {% endif %}
              </div>
              <div class="room-stat-label">Result</div>
              <div class="room-stat-compare">
                Overall win rate: {{ room.stats.overallWinRate }}% across {{ room.stats.totalPlayed }} rooms
              </div>
            </div>

            {% if room.stats.companyTotal > 1 and room.company %}
            <div class="room-stat-card">
              <div class="room-stat-value">{{ room.stats.companyWins }}/{{ room.stats.companyTotal }}</div>
              <div class="room-stat-label">Wins at {{ room.company.name }}</div>
              <div class="room-stat-compare">
                {{ ((room.stats.companyWins / room.stats.companyTotal) * 100) | round }}% win rate at this company
              </div>
            </div>
            {% endif %}

            {% if room.players and room.players.length > 0 %}
            <div class="room-stat-card">
              <div class="room-stat-value">{{ room.players.length }}</div>
              <div class="room-stat-label">Players</div>
              <div class="room-stat-compare">
                {% for player in room.players %}{{ player.name }}{% if not loop.last %}, {% endif %}{% endfor %}
              </div>
            </div>
            {% endif %}
      </div>
    </section>
    {% endif %}

    {% if room.experiences and room.experiences.length > 0 %}
    <section class="room-ratings-section">
      <div class="section-header">
        <h2>Team Ratings</h2>
        <p>The qualitative side of the team log: scores, category notes, and favorite votes from Escaping Things.</p>
      </div>
      <div class="room-ratings-summary">
        {% if room.ratingSummary.average != null %}
        <div class="room-rating-summary-card">
          <div class="room-rating-summary-value">{{ room.ratingSummary.average | formatRating }}/5</div>
          <div class="room-rating-summary-label">Average Rating</div>
        </div>
        {% endif %}
        <div class="room-rating-summary-card">
          <div class="room-rating-summary-value">{{ room.ratingSummary.count }}</div>
          <div class="room-rating-summary-label">Team Ratings</div>
        </div>
        {% if room.ratingSummary.bestThingsCount > 0 %}
        <div class="room-rating-summary-card">
          <div class="room-rating-summary-value">{{ room.ratingSummary.bestThingsCount }}</div>
          <div class="room-rating-summary-label">Favorite Votes</div>
        </div>
        {% endif %}
      </div>
      <div class="room-ratings-grid">
        {% for experience in room.experiences %}
        <article class="room-rating-card">
          <div class="room-rating-card-header">
            <div>
              <h3>{{ experience.player.name }}</h3>
            </div>
            {% if experience.rating != null %}
            <div class="room-rating-card-score">{{ experience.rating | formatRating }}/5</div>
            {% endif %}
          </div>
          <div class="room-rating-chip-row">
            {% if experience.gameplay %}
            <span class="room-rating-chip">Gameplay: {{ experience.gameplay }}</span>
            {% endif %}
            {% if experience.atmosphere %}
            <span class="room-rating-chip">Atmosphere: {{ experience.atmosphere }}</span>
            {% endif %}
            {% if experience.experience %}
            <span class="room-rating-chip">Experience: {{ experience.experience }}</span>
            {% endif %}
            {% if experience.bestThings %}
            <span class="room-rating-chip room-rating-chip-best">Best Things</span>
            {% endif %}
          </div>
          {% if experience.comments %}
          <div class="room-rating-comments rich-text">{{ experience.comments | richText | safe }}</div>
          {% endif %}
        </article>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {% if room.stats.relatedRooms.length > 0 %}
    <section class="room-related-section">
      <div class="section-header">
        <h2>Related Rooms</h2>
        <p>Picked from shared themes, people, places, and AI-generated room similarity hints.</p>
      </div>
      <div class="room-grid">
        {% for other in room.stats.relatedRooms %}
        {{ roomCard(other) }}
        {% endfor %}
      </div>
    </section>
    {% endif %}
  </main>
{% endblock %}

{% block scripts %}
  <script type="module">
    import { initNav } from '{{ '/js/data.js' | cacheBust }}';
    initNav();
  </script>
{% endblock %}
