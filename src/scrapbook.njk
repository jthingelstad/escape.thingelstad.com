---
title: Scrapbook
description: A photo scrapbook of our escape room adventures.
permalink: /scrapbook/
---
{% extends "base.njk" %}

{% block content %}
  <main class="container page-content">
    <section class="page-intro">
      <div class="eyebrow">Photo Archive</div>
      <div class="page-intro-copy">
        <h1 class="page-intro-title">Scrapbook</h1>
        <p>Photos from our escape room adventures, still playful, but now tied back into the same archival system as the rest of the site.</p>
      </div>
    </section>

    <div class="scrapbook-controls" id="scrapbook-controls"></div>

    <div class="scrapbook-table" id="scrapbook-table"></div>
  </main>
{% endblock %}

{% block scripts %}
  <script id="scrapbook-data" type="application/json">{{ scrapbook | dump | safe }}</script>
  <script type="module" src="{{ '/js/scrapbook.js' | cacheBust }}"></script>
{% endblock %}
