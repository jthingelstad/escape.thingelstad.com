---
pagination:
  data: tripPages
  size: 1
  alias: trip
  addAllPagesToCollections: true
permalink: /trip/{{ trip.slug }}/
---
{% extends "base.njk" %}
{% from "room-card.njk" import roomCard %}

{% block pageTitle %}{{ trip.name }} — Featured Trip{% endblock %}
{% block metaDescription %}Featured trip page for {{ trip.name }} with the rooms and places attached to it.{% endblock %}
{% block socialTitle %}{{ trip.name }} — Featured Trip - Escaping Things{% endblock %}
{% block socialDescription %}Follow {{ trip.name }} in room order, with its route, places, and linked room details.{% endblock %}

{% block head %}
  {% if trip.mapStops.length > 0 %}
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  {% endif %}
{% endblock %}

{% block content %}
  <main class="container page-content featured-detail-page" id="main-content" data-pagefind-body data-pagefind-meta="type:trip">
    <section class="featured-detail-hero">
      <div>
        <div class="eyebrow">Featured trip · {{ trip.roomCount }} rooms</div>
        <h1>{{ trip.name }}</h1>
        {% if trip.firstDate and trip.lastDate %}
        <p class="featured-detail-copy">{{ trip.firstDate | formatDate }} to {{ trip.lastDate | formatDate }}</p>
        {% endif %}
      </div>
    </section>

    {% if trip.routeStops.length > 0 %}
    <section class="trip-route-section" id="route">
      <div class="section-header">
        <h2 data-pagefind-ignore>Route <a class="heading-anchor" href="#route" aria-label="Link to Route">#</a></h2>
        <p>The trip in room order, with each stop marked on the map.</p>
      </div>
      <div class="room-grid">
        {% for stop in trip.routeStops %}
          {{ roomCard(stop.room, { badgeLabel: 'Stop', badgeNumber: stop.sequence, returnPath: page.url }) }}
        {% endfor %}
      </div>
      {% if trip.mapStops.length > 0 %}
      <div class="trip-map-container" id="trip-map"></div>
      {% endif %}
    </section>
    {% endif %}

    {% if trip.lists.length > 0 %}
    <section id="lists">
      <div class="section-header">
        <h2 data-pagefind-ignore>Lists <a class="heading-anchor" href="#lists" aria-label="Link to Lists">#</a></h2>
      </div>
      <div class="list-summary-grid">
        {% for list in trip.lists %}
        <a href="{{ list | entityUrl('list') }}" class="list-summary-card" data-tinylytics-event="trip.list" data-tinylytics-event-value="{{ list.name }}">
          <div class="feature-tile-kicker">List</div>
          <h3>{{ list.name }}</h3>
          <p>{{ list.roomCount }} room{{ '' if list.roomCount == 1 else 's' }}</p>
        </a>
        {% endfor %}
      </div>
    </section>
    {% endif %}

  </main>
{% endblock %}

{% block scripts %}
  {% if trip.mapStops.length == 0 %}
  <script type="module">
    import { initNav } from '{{ '/js/data.js' | cacheBust }}';
    initNav();
  </script>
  {% endif %}
  {% if trip.mapStops.length > 0 %}
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script id="trip-map-data" type="application/json">{{ trip.mapStops | dump | safe }}</script>
  <script type="module" src="{{ '/js/trip.js' | cacheBust }}"></script>
  {% endif %}
{% endblock %}
